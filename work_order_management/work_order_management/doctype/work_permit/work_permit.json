  {
   "fieldname": "check_1",
   "fieldtype": "Select",
   "label": "1. Power supply switched off and electrical equipment etc. moved away.",
   "options": "\nYes\nNo\nN/A",
   "reqd": 1
  },
  {
   "fieldname": "check_2",
   "fieldtype": "Select",
   "label": "2. Safety locks / tags etc. applied.",
   "options": "\nYes\nNo\nN/A",
   "reqd": 1
