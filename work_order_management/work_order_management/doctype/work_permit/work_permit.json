  {
   "fieldname": "declaration_1",
   "fieldtype": "HTML",
   "options": "<div style=\"background:var(--yellow-50,#FFF4D0);border:1.5px dashed #DDA800;border-radius:12px;padding:12px 14px\"><span style=\"font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;background:#FFC21A;color:#2B2100;padding:2px 9px;border-radius:999px\">Declaration</span><p style=\"margin:10px 0 0;color:#2B2100\">I declare that I have checked the work area thoroughly and the work can now be carried out here without hazard. I am responsible for cleaning the affected area once the work is complete, and for informing the concerned department and getting its clearance.</p></div>"
  },
